{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/gsr/backward/customer_v3.json",
  "title": "Customer",
  "description": "Third backward evolution - added optional 'preferences' (array of enum) demonstrating BACKWARD_ALL",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "email", "address"],
  "properties": {
    "id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "city", "postalCode"],
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "postalCode": { "type": "string" }
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["email", "sms", "push", "none"]
      },
      "default": []
    }
  }
}
