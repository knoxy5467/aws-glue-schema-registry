{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/gsr/forward/invoice_v3.json",
  "title": "Invoice",
  "description": "Third forward evolution - added required 'paymentTerms' (integer days), demonstrates FORWARD_ALL",
  "type": "object",
  "additionalProperties": false,
  "required": ["invoiceId", "issued", "lineItems", "total", "status", "paymentTerms"],
  "properties": {
    "invoiceId": {
      "type": "string"
    },
    "issued": {
      "type": "string",
      "format": "date-time"
    },
    "lineItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "unitPrice"],
        "properties": {
          "description": { "type": "string" },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "multipleOf": 0.01
          }
        }
      }
    },
    "total": {
      "type": "number",
      "multipleOf": 0.01
    },
    "status": {
      "type": "string",
      "enum": ["draft", "issued", "paid", "void"]
    },
    "paymentTerms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    }
  }
}
