{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/gsr/forward/invoice_v1.json",
  "title": "Invoice",
  "description": "Base forward-compatibility schema - hazard: date-time format, array of line items (nested objects)",
  "type": "object",
  "additionalProperties": false,
  "required": ["invoiceId", "issued", "lineItems", "total"],
  "properties": {
    "invoiceId": {
      "type": "string"
    },
    "issued": {
      "type": "string",
      "format": "date-time"
    },
    "lineItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "unitPrice"],
        "properties": {
          "description": { "type": "string" },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "multipleOf": 0.01
          }
        }
      }
    },
    "total": {
      "type": "number",
      "multipleOf": 0.01
    }
  }
}
